# Optional local signing secret. Generate a unique value before setting this.
# If unset, the API creates an in-memory secret and login tokens expire on restart.
SKILLSYNC_SECRET_KEY=
SKILLSYNC_DB_PATH=backend/data/skillsync.sqlite3
SKILLSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
